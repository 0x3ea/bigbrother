# 复制为 .env 并填入真实密码:.env 已被 .gitignore 忽略,不会提交
# 密码与建账号时的 GRANT 语句保持一致(openssl rand -hex 12 生成)

# 应用使用的库(表结构由程序启动时自动迁移)
BIGBROTHER_DSN=bigbrother:换成你的密码@tcp(127.0.0.1:3306)/bigbrother?parseTime=true&loc=Local

# 集成测试用(库名那段是占位,测试只会碰 bigbrother_migrate_test)
BIGBROTHER_TEST_DSN=bigbrother:换成你的密码@tcp(127.0.0.1:3306)/ignored?parseTime=true
